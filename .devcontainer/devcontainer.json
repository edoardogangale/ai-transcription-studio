{
  "name": "AI Transcription Studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg",
  "postStartCommand": "bash scripts/codespace_start.sh",
  "postAttachCommand": "bash scripts/show_access.sh",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "AI Transcription Studio", "onAutoForward": "openBrowser" } },
  "customizations": { "vscode": { "settings": { "terminal.integrated.defaultProfile.linux": "bash" } } }
}
