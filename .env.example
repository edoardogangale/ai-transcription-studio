# Tutte le variabili sono opzionali. Esportale prima di avviare (o usa scripts/start.sh --lan).
# STUDIO_DATA=./data            # dove vengono salvati audio, database e pesi dei modelli
# STUDIO_TOKEN=cambia-questo    # se impostato, serve per accedere all'API (obbligatorio se esponi il server in LAN)
# STUDIO_THREADS=4              # thread CPU per ogni modello (predefinito: tutti i core)
# OLLAMA_URL=http://127.0.0.1:11434   # LLM locale per la modalità C (Appunti strutturati)
